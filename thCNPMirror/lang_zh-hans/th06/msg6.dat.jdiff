{
    "2": {
        "60_0": {
            "lines": [
                "趁着大小姐还没动怒",
                "至少得消耗掉你一个Bomb～"
            ]
        },
        "150_0": {
            "lines": [
                "你就不能闭上嘴，",
                "乖乖出门跑腿去吗？"
            ]
        }
    },
    "0": {
        "60_0": {
            "lines": [
                "你也差不多该亮相了吧？"
            ]
        },
        "61_0": {
            "lines": [
                "大小姐？"
            ]
        },
        "242_h1_0": {
            "lines": [
                "永远鲜红的幼月",
                "蕾米莉亚·斯卡蕾特"
            ]
        },
        "242_0": {
            "lines": [
                "果然，人类就是不中用啊"
            ]
        },
        "243_0": {
            "lines": [
                "刚才那个女仆原来是人类啊"
            ]
        },
        "244_0": {
            "lines": [
                "你是个杀人犯呢"
            ]
        },
        "245_0": {
            "lines": [
                "没关系的",
                "就杀一个还算不上屠杀"
            ]
        },
        "247_0": {
            "lines": [
                "你有事吗？"
            ]
        },
        "248_0": {
            "lines": [
                "噢对了，你这家伙",
                "太烦人了"
            ]
        },
        "250_0": {
            "lines": [
                "真毛躁啊，说话也莫名其妙"
            ]
        },
        "251_0": {
            "lines": [
                "总之，能请你离开这里吗？"
            ]
        },
        "253_0": {
            "lines": [
                "这可是我的城堡哎？"
            ]
        },
        "254_0": {
            "lines": [
                "该离开的人是你。"
            ]
        },
        "255_0": {
            "lines": [
                "我是叫你永远离开人世"
            ]
        },
        "256_0": {
            "lines": [
                "真没办法"
            ]
        },
        "257_0": {
            "lines": [
                "我现在其实已经很饱了……"
            ]
        },
        "258_0": {
            "lines": [
                "你不是雇了那个女仆",
                "给自己当护卫吗？"
            ]
        },
        "260_0": {
            "lines": [
                "像你这种娇生惯养的大小姐",
                "我一招就能收拾掉！"
            ]
        },
        "262_0": {
            "lines": [
                "咲夜是一名优秀的清洁工"
            ]
        },
        "263_0": {
            "lines": [
                "多亏了她，我家地板干净得",
                "连一颗人头都找不到"
            ]
        },
        "264_0": {
            "lines": [
                "你很强吗？"
            ]
        },
        "265_0": {
            "lines": [
                "谁知道呢。",
                "我没什么机会出门"
            ]
        },
        "267_0": {
            "lines": [
                "因为我害怕阳光"
            ]
        },
        "268_0": {
            "lines": [
                "……",
                "你还挺厉害的嘛"
            ]
        },
        "270_0": {
            "lines": [
                "月光已是如此鲜红",
                "我会使出全力取你性命哦"
            ]
        },
        "272_0": {
            "lines": [
                "月光分明如此鲜红"
            ]
        },
        "273_0": {
            "lines": [
                "看来今夜会很快乐呢",
                "看来今夜会很漫长呢"
            ]
        }
    },
    "12": {
        "60_0": {
            "lines": [
                "你这种人倒也挺少见的",
                "这边什么都没有哦"
            ]
        },
        "150_0": {
            "lines": [
                "彼此彼此",
                "你真的是女仆吗？"
            ]
        }
    },
    "10": {
        "60_0": {
            "lines": [
                "找到了找到了",
                "这股妖气，真让人毛骨悚然"
            ]
        },
        "61_0": {
            "lines": [
                "为什么实力强大的家伙",
                "总爱躲躲藏藏呢？"
            ]
        },
        "243_h1_0": {
            "lines": [
                "永远鲜红的幼月",
                "蕾米莉亚·斯卡蕾特"
            ]
        },
        "242_0": {
            "lines": [
                "这就叫……",
                "君子动脑不露相"
            ]
        },
        "244_0": {
            "lines": [
                "……看来这位菌子没什么脑子呀"
            ]
        },
        "245_0": {
            "lines": [
                "只有人类"
            ]
        },
        "246_0": {
            "lines": [
                "才需要大脑这种",
                "构造简单的化学性思考中枢"
            ]
        },
        "248_0": {
            "lines": [
                "你是那啥吧？"
            ]
        },
        "249_0": {
            "lines": [
                "就那个，讨厌阳光和难闻的蔬菜"
            ]
        },
        "250_0": {
            "lines": [
                "还害怕银器"
            ]
        },
        "251_0": {
            "lines": [
                "明明是黑夜的君主",
                "却有一大堆弱点……"
            ]
        },
        "253_0": {
            "lines": [
                "是呀，我就是个体弱多病的小姑娘"
            ]
        },
        "254_0": {
            "lines": [
                "挺有趣的嘛。你是不是会喝——",
                "那个呀？"
            ]
        },
        "256_0": {
            "lines": [
                "那是自然",
                "但我胃口很小，总是喝不完"
            ]
        },
        "258_0": {
            "lines": [
                "你至今为止吸过多少人的血？"
            ]
        },
        "259_0": {
            "lines": [
                "你会记得自己至今为止",
                "吃过多少片面包吗？"
            ]
        },
        "261_0": {
            "lines": [
                "13片",
                "我是和食主义者"
            ]
        },
        "263_0": {
            "lines": [
                "所以，你是来干嘛的？"
            ]
        },
        "264_0": {
            "lines": [
                "我其实已经很饱了……"
            ]
        },
        "265_0": {
            "lines": [
                "是吗，我倒有些饿了"
            ]
        },
        "266_0": {
            "lines": [
                "……想吃，就吃吧"
            ]
        },
        "267_0": {
            "lines": [
                "啊，是吗"
            ]
        },
        "268_0": {
            "lines": [
                "我刚说的是个人名",
                "「阿诗玛」"
            ]
        },
        "270_0": {
            "lines": [
                "人类可真有趣"
            ]
        },
        "271_0": {
            "lines": [
                "或者说，你并不是人类？"
            ]
        },
        "273_0": {
            "lines": [
                "我是个有趣的人类哦"
            ]
        },
        "274_0": {
            "lines": [
                "呵呵，也许是因为月光如此鲜红吧？"
            ]
        },
        "275_0": {
            "lines": [
                "看来今夜会很炽热呢",
                "看来今夜会很清凉呢"
            ]
        }
    }
}