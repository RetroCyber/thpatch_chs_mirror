{
    "8": {
        "lines": [
            "　　夏天的神社门可罗雀。",
            "　　歇息了好一阵子的太阳终于露了面，",
            "　　神社周边接连数日都是大晴天。",
            "　　四下不见人影，唯有聒噪的蝉鸣不绝于耳……"
        ]
    },
    "15": {
        "lines": [
            "　灵梦　「这才称得上是夏天嘛",
            "　　　　　之前那种阴沉沉的夏天，连葵花籽油都要减产啦」"
        ]
    },
    "18": {
        "lines": [
            "　灵梦　「要是来神社参拜的人再多点就更好了」"
        ]
    },
    "21": {
        "lines": [
            "　？？　「确实啊——",
            "　　　　　萧条成这样，你这生意真能做吗？」"
        ]
    },
    "26": {
        "lines": [
            "　灵梦　「你这家伙又不是人",
            "　　　　　你要别在这瞎逛，生意没准还能好点呢？」"
        ]
    },
    "30": {
        "lines": [
            "蕾米莉亚「真没礼貌。",
            "　　　　　像这么偏僻的地方，就算我不在，",
            "　　　　　压根也不会有人来」"
        ]
    },
    "35": {
        "lines": [
            "　灵梦　「我说，你不是害怕阳光吗？",
            "　　　　　赶紧给我灰飞烟灭啊。」"
        ]
    },
    "39": {
        "lines": [
            "蕾米莉亚「我撑着阳伞呢」"
        ]
    },
    "76": {
        "lines": [
            "　　ＥＮＤＩＮＧ　Ｎｏ．３"
        ]
    },
    "42": {
        "lines": [
            "　灵梦　「撑把伞就行？那你弄出那么多雾干啥(^^;」"
        ]
    },
    "46": {
        "lines": [
            "蕾米莉亚「快住手，我要被晒到了！」"
        ]
    },
    "49": {
        "lines": [
            "　灵梦　「瞧你这惨白的脸色，",
            "　　　　　还是稍微晒黑点比较好吧？」"
        ]
    },
    "53": {
        "lines": [
            "蕾米莉亚「晒黑之前我会先汽化的」"
        ]
    },
    "56": {
        "lines": [
            "蕾米莉亚「一旦吸入我汽化形成的气体，",
            "　　　　　就会获得永恒的生命」"
        ]
    },
    "60": {
        "lines": [
            "　灵梦　「……那我可不干」"
        ]
    },
    "63": {
        "lines": [
            "蕾米莉亚「是吧是吧？」"
        ]
    },
    "66": {
        "lines": [
            "　灵梦　「给我20年的寿命就够了」"
        ]
    },
    "69": {
        "lines": [
            "蕾米莉亚「呜哇」"
        ]
    },
    "72": {
        "lines": [
            "　　平静的夏日兼具无穷的时间。",
            "　　永恒的神社似乎千秋万代也不会改变。"
        ]
    }
}