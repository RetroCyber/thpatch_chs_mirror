{
    "80": {
        "lines": [
            "　　ENDING　No.4"
        ]
    },
    "8": {
        "lines": [
            "　　夏天的神社门可罗雀。",
            "　　歇息了好一阵子的太阳终于露了面，",
            "　　神社周边接连数日都是大晴天。",
            "　　四下不见人影，唯有聒噪的蝉鸣不绝于耳……"
        ]
    },
    "76": {
        "lines": [
            "　　和平正在缓缓笼罩幻想之夏，",
            "\t　　就像青苔覆盖河滩乱石一般慢条斯理……"
        ]
    },
    "15": {
        "lines": [
            "　灵梦　「啊——今天也太热了吧",
            "　　　　　这叫人还怎么做事」"
        ]
    },
    "18": {
        "lines": [
            "　灵梦　「不过本来也没人，根本就无事可做呀」"
        ]
    },
    "21": {
        "lines": [
            "　？？　「那就来讲鬼故事吧，",
            "　　　　　既能消暑解热又能消磨时间」"
        ]
    },
    "24": {
        "lines": [
            "　灵梦　「唉，一个人待着也挺空虚啊」"
        ]
    },
    "27": {
        "lines": [
            "　？？　「还有一个人呢」"
        ]
    },
    "31": {
        "lines": [
            "　灵梦　「你算哪门子的人！！」"
        ]
    },
    "34": {
        "lines": [
            "蕾米莉亚「随便你吧，",
            "　　　　　话说这屋子还真寒酸」"
        ]
    },
    "38": {
        "lines": [
            "　灵梦　「要你管，神社就是这样的」"
        ]
    },
    "41": {
        "lines": [
            "蕾米莉亚「这样的屋子正适合讲鬼故事，",
            "　　　　　肯定会很凉快的」"
        ]
    },
    "44": {
        "lines": [
            "　灵梦　「凭什么我要在大白天陪着怪物讲鬼故事呀」"
        ]
    },
    "49": {
        "lines": [
            "蕾米莉亚「等到夜里再讲，也可以哦」"
        ]
    },
    "52": {
        "lines": [
            "　灵梦　「等你个头」"
        ]
    },
    "55": {
        "lines": [
            "　灵梦　「……说呀？」"
        ]
    },
    "58": {
        "lines": [
            "蕾米莉亚「啊？」"
        ]
    },
    "61": {
        "lines": [
            "　灵梦　「你要讲什么鬼故事？」"
        ]
    },
    "64": {
        "lines": [
            "蕾米莉亚「嗯——故事的主角是一位活了500多年的少女。」"
        ]
    },
    "67": {
        "lines": [
            "　灵梦　「少女？怎么了？」"
        ]
    },
    "70": {
        "lines": [
            "蕾米莉亚「就是我」"
        ]
    },
    "73": {
        "lines": [
            "　灵梦　「……你可别吸我血呀」"
        ]
    }
}