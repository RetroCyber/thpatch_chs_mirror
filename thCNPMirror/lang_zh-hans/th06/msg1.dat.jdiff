{
    "0": {
        "60_1": {
            "lines": [
                "感觉真惬意"
            ]
        },
        "61_0": {
            "lines": [
                "每次白天出门都见不到几个恶灵",
                "所以今天改成了晚上出发……"
            ]
        },
        "62_0": {
            "lines": [
                "可这黑灯瞎火的",
                "根本搞不清该往哪儿走呀"
            ]
        },
        "83_0": {
            "lines": [
                "不过……"
            ]
        },
        "84_0": {
            "lines": [
                "神社后院到了晚上还挺浪漫嘛",
                "（←悠哉）"
            ]
        },
        "124_0": {
            "lines": [
                "可不是嘛～",
                "而且还会闹鬼，简直太棒了"
            ]
        },
        "135_0": {
            "lines": [
                "等等，",
                "你谁呀？"
            ]
        },
        "135_h1_0": {
            "lines": [
                "宵暗的妖怪",
                "露米娅"
            ]
        },
        "136_0": {
            "lines": [
                "我们刚才不是见过面吗",
                "难不成，你是雀盲眼？"
            ]
        },
        "137_0": {
            "lines": [
                "人在黑暗之中",
                "本来就看不清东西啦"
            ]
        },
        "138_0": {
            "lines": [
                "咦？可我好像也见过",
                "只在夜间活动的人呀"
            ]
        },
        "139_0": {
            "lines": [
                "那种人可以直接抓来吃哦"
            ]
        },
        "140_0": {
            "lines": [
                "是—这样吗—"
            ]
        },
        "141_0": {
            "lines": [
                "话说，你挡我道了"
            ]
        },
        "142_0": {
            "lines": [
                "眼前这个人类就能抓来吃？"
            ]
        },
        "143_0": {
            "lines": [
                "有句话叫良药苦于口",
                "你不知道吗？"
            ]
        },
        "60_0": {
            "lines": [
                "好久没开工啦"
            ]
        }
    },
    "1": {
        "60_0": {
            "lines": [
                "但是不是良药"
            ]
        },
        "60_1": {
            "lines": [
                "只有喝了才知道哦"
            ]
        }
    },
    "10": {
        "60_0": {
            "lines": [
                "这种感觉，该怎么形容呢……"
            ]
        },
        "61_0": {
            "lines": [
                "换做是那家伙，肯定会说什么",
                "「感觉真惬意」吧"
            ]
        },
        "62_0": {
            "lines": [
                "但我可不喜欢夜晚"
            ]
        },
        "63_0": {
            "lines": [
                "路上碰到的全是怪胎"
            ]
        },
        "103_0": {
            "lines": [
                "你说谁是怪胎呢"
            ]
        },
        "104_h1_0": {
            "lines": [
                "宵暗的妖怪",
                "露米娅"
            ]
        },
        "104_0": {
            "lines": [
                "我可没说你"
            ]
        },
        "105_0": {
            "lines": [
                "这个嘛，我当然不是"
            ]
        },
        "106_0": {
            "lines": [
                "所以，你把手伸这么开干嘛"
            ]
        },
        "107_0": {
            "lines": [
                "这样看起来像不像",
                "「圣人被钉在十字架上」？"
            ]
        },
        "108_0": {
            "lines": [
                "我看更像是",
                "「人类采用了十进制」"
            ]
        }
    },
    "11": {
        "60_0": {
            "lines": [
                "难道说"
            ]
        },
        "60_1": {
            "lines": [
                "只有人类是十根手指吗"
            ]
        }
    }
}