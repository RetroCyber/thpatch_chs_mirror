{
    "2": {
        "60_0": {
            "lines": [
                "什么呀",
                "你又来了？"
            ]
        },
        "150_0": {
            "lines": [
                "我又来了"
            ]
        },
        "221_0": {
            "lines": [
                "今天我的哮喘好多了"
            ]
        },
        "282_0": {
            "lines": [
                "就让你见识见识",
                "我的魔法杀手锏！"
            ]
        }
    },
    "0": {
        "60_0": {
            "lines": [
                "今天真是热得不同寻常"
            ]
        },
        "61_0": {
            "lines": [
                "敌人的火力这么猛烈"
            ]
        },
        "62_0": {
            "lines": [
                "是因为刚才那姑娘发疯了吗？"
            ]
        },
        "64_0": {
            "lines": [
                "你太天真了！",
                "那边的红白！"
            ]
        },
        "66_0": {
            "lines": [
                "疯子还不止一个？"
            ]
        },
        "247_h1_0": {
            "lines": [
                "恶魔的妹妹",
                "芙兰朵露·斯卡蕾特"
            ]
        },
        "247_0": {
            "lines": [
                "久等了"
            ]
        },
        "248_0": {
            "lines": [
                "你是谁？我以前来的时候",
                "好像没见过你……"
            ]
        },
        "250_0": {
            "lines": [
                "我一直都在，只是你没看见罢了"
            ]
        },
        "251_0": {
            "lines": [
                "难道你就是人类？"
            ]
        },
        "252_0": {
            "lines": [
                "对呀"
            ]
        },
        "253_0": {
            "lines": [
                "你没骗我吧？"
            ]
        },
        "254_0": {
            "lines": [
                "我只见过变成饮料的人类"
            ]
        },
        "256_0": {
            "lines": [
                "没骗你，我就是人类"
            ]
        },
        "257_0": {
            "lines": [
                "人类，可比红茶复杂多了。",
                "至少绝大多数人是这样的"
            ]
        },
        "259_0": {
            "lines": [
                "你想，鸡这种动物呀"
            ]
        },
        "260_0": {
            "lines": [
                "啥？"
            ]
        },
        "261_0": {
            "lines": [
                "哪怕是不会杀鸡的人",
                "照样能品尝美味的鸡肉"
            ]
        },
        "263_0": {
            "lines": [
                "你家是由谁负责宰杀人类呢？"
            ]
        },
        "265_0": {
            "lines": [
                "谁知道呢——？",
                "反正不可能是姐姐……"
            ]
        },
        "267_0": {
            "lines": [
                "姐姐？"
            ]
        },
        "268_0": {
            "lines": [
                "你是说那个叫雷普莉卡的恶魔？"
            ]
        },
        "269_0": {
            "lines": [
                "是蕾米莉亚！",
                "蕾米莉亚姐姐"
            ]
        },
        "271_0": {
            "lines": [
                "那家伙肯定对烹饪一窍不通"
            ]
        },
        "273_0": {
            "lines": [
                "姐姐从没下过厨"
            ]
        },
        "274_0": {
            "lines": [
                "小妹妹，听我说"
            ]
        },
        "275_0": {
            "lines": [
                "你那姐姐成天在我家神社晃悠",
                "烦的不得了"
            ]
        },
        "277_0": {
            "lines": [
                "你能不能说说她"
            ]
        },
        "278_0": {
            "lines": [
                "这事我知道。"
            ]
        },
        "279_0": {
            "lines": [
                "我也打算过去……"
            ]
        },
        "280_0": {
            "lines": [
                "别了"
            ]
        },
        "281_0": {
            "lines": [
                "可是却被拦住了",
                "外面下着大雨，我连一步都走不动"
            ]
        },
        "283_0": {
            "lines": [
                "合着你是个危险人物呀",
                "你以前干了什么坏事吗？"
            ]
        },
        "285_0": {
            "lines": [
                "我怎么可能干坏事呢"
            ]
        },
        "286_0": {
            "lines": [
                "这495年来",
                "我一次都没出过门呢"
            ]
        },
        "288_0": {
            "lines": [
                "完全就是问题儿童啊"
            ]
        },
        "289_0": {
            "lines": [
                "可今天玩具自己飞进来了……"
            ]
        },
        "290_0": {
            "lines": [
                "你要玩什么？"
            ]
        },
        "291_0": {
            "lines": [
                "弹幕游戏"
            ]
        },
        "292_0": {
            "lines": [
                "哦，画图案的游戏呗",
                "这可是我的拿手好戏"
            ]
        }
    },
    "1": {
        "61_0": {
            "lines": [
                "瞧见没？",
                "这就是侍奉神明之人的力量！"
            ]
        },
        "63_0": {
            "lines": [
                "别以为这就算赢了"
            ]
        },
        "64_0": {
            "lines": [
                "好戏才刚刚开始呢！"
            ]
        },
        "65_0": {
            "lines": [
                "！？"
            ]
        },
        "66_0": {
            "lines": [
                "少唬人，你哪还有什么余力"
            ]
        },
        "67_0": {
            "lines": [
                "是啊，我连一丝烟都冒不出来了"
            ]
        },
        "68_0": {
            "lines": [
                "我以后会经常过来找你玩的"
            ]
        },
        "69_0": {
            "lines": [
                "所以算我求你了，别跑到神社来"
            ]
        },
        "70_0": {
            "lines": [
                "是吗，我本来还准备",
                "带些蛋糕和红茶送给你呢。"
            ]
        },
        "72_0": {
            "lines": [
                "你家的食物可不能摆到人类面前"
            ]
        },
        "74_0": {
            "lines": [
                "都是低糖的哦？"
            ]
        },
        "75_0": {
            "lines": [
                "无糖也不行！"
            ]
        },
        "76_0": {
            "lines": [
                "好孩子现在应该乖乖回家睡觉了"
            ]
        },
        "78_0": {
            "lines": [
                "……这里就是我家呀？"
            ]
        },
        "79_0": {
            "lines": [
                "你是坏孩子",
                "那就不用回了"
            ]
        },
        "81_0": {
            "lines": [
                "反正我得回去了"
            ]
        },
        "82_0": {
            "lines": [
                "坏孩子不用回去哦"
            ]
        },
        "83_0": {
            "lines": [
                "……还有个坏孩子留在神社里呢"
            ]
        },
        "85_0": {
            "lines": [
                "坏孩子是说谁呀？"
            ]
        },
        "86_0": {
            "lines": [
                "就是你和你姐啦！！"
            ]
        }
    },
    "12": {
        "60_0": {
            "lines": [
                "什么呀",
                "你又来了？"
            ]
        },
        "150_0": {
            "lines": [
                "是你吗？",
                "是你干的好事吗？"
            ]
        },
        "221_0": {
            "lines": [
                "我现在没工夫搭理你啊——"
            ]
        },
        "282_0": {
            "lines": [
                "二小姐正闹腾，你还来添乱",
                "今天真是倒霉到家了！"
            ]
        }
    },
    "10": {
        "60_0": {
            "lines": [
                "怎么回事啊？",
                "这宅子"
            ]
        },
        "61_0": {
            "lines": [
                "蕾米莉亚不是在神社嘛"
            ]
        },
        "62_0": {
            "lines": [
                "这里的火力",
                "为什么还是这么猛？"
            ]
        },
        "64_0": {
            "lines": [
                "有人叫我吗？"
            ]
        },
        "65_0": {
            "lines": [
                "没叫你"
            ]
        },
        "246_0": {
            "lines": [
                "久等了"
            ]
        },
        "247_0": {
            "lines": [
                "你谁啊？"
            ]
        },
        "248_0": {
            "lines": [
                "打听别人姓名之前……"
            ]
        },
        "249_0": {
            "lines": [
                "啊，我先说吗？"
            ]
        },
        "250_0": {
            "lines": [
                "这个嘛，我叫博丽灵梦，是个巫女"
            ]
        },
        "252_h1_0": {
            "lines": [
                "恶魔的妹妹",
                "芙兰朵露·斯卡蕾特"
            ]
        },
        "251_0": {
            "lines": [
                "我是芙兰朵露",
                "魔理沙小姐（你可不像巫女哦）"
            ]
        },
        "253_0": {
            "lines": [
                "你是什么人？",
                "（刚刚是不是应该说护士呢？）"
            ]
        },
        "255_0": {
            "lines": [
                "我一直待在这个家里"
            ]
        },
        "256_0": {
            "lines": [
                "你天天赖在这儿不走的时候",
                "我都在"
            ]
        },
        "258_0": {
            "lines": [
                "有你这号人吗？"
            ]
        },
        "259_0": {
            "lines": [
                "我一直在地底下休息"
            ]
        },
        "260_0": {
            "lines": [
                "休息了大概495年吧"
            ]
        },
        "261_0": {
            "lines": [
                "真好，我一周才休息两天呢"
            ]
        },
        "262_0": {
            "lines": [
                "你平时跟姐姐聊天的时候",
                "我都听着呢"
            ]
        },
        "264_0": {
            "lines": [
                "姐姐？",
                "你是蕾米莉亚的妹妹吗"
            ]
        },
        "266_0": {
            "lines": [
                "我也想出去看看所谓的人类"
            ]
        },
        "268_0": {
            "lines": [
                "这不正好",
                "看吧看吧，随便你看"
            ]
        },
        "270_0": {
            "lines": [
                "你能陪我玩嘛？"
            ]
        },
        "271_0": {
            "lines": [
                "你出多少钱？"
            ]
        },
        "272_0": {
            "lines": [
                "一个硬币"
            ]
        },
        "273_0": {
            "lines": [
                "才一个硬币",
                "连人命都买不起呀"
            ]
        },
        "275_0": {
            "lines": [
                "你这样",
                "是没法续关的哦！"
            ]
        }
    },
    "11": {
        "61_0": {
            "lines": [
                "咋样啊，开心了吗？"
            ]
        },
        "62_0": {
            "lines": [
                "这是在做梦吗",
                "我怎么可能会输……"
            ]
        },
        "64_0": {
            "lines": [
                "嗯，没准真是梦呢"
            ]
        },
        "65_0": {
            "lines": [
                "今天我就先回去啦"
            ]
        },
        "66_0": {
            "lines": [
                "啊，玩得真尽兴"
            ]
        },
        "67_0": {
            "lines": [
                "可到头来，又只剩下我一个人了吗"
            ]
        },
        "68_0": {
            "lines": [
                "♪！"
            ]
        },
        "69_0": {
            "lines": [
                "你落单了就会上吊吗？"
            ]
        },
        "70_0": {
            "lines": [
                "为什么？"
            ]
        },
        "71_0": {
            "lines": [
                "She went and hanged herself",
                "and then there were none."
            ]
        },
        "73_0": {
            "lines": [
                "（一个小姑娘，落单孤零零",
                "　悬梁了此生，一个也不剩）"
            ]
        },
        "75_0": {
            "lines": [
                "你这是从哪里听来的呀——"
            ]
        },
        "76_0": {
            "lines": [
                "这是一首著名的童谣哦"
            ]
        },
        "77_0": {
            "lines": [
                "我本来还打算让你来当",
                "这最后一个人呢"
            ]
        },
        "79_0": {
            "lines": [
                "你是说刚才你在消失不见时",
                "施展的攻击吗"
            ]
        },
        "81_0": {
            "lines": [
                "She died by the bullet",
                "and then there were none."
            ]
        },
        "83_0": {
            "lines": [
                "（一个小姑娘，落单孤零零",
                "　弹幕躲不开，一个也不剩）"
            ]
        },
        "85_0": {
            "lines": [
                "不好意思呀，搅了你的如意算盘。",
                "谁叫我这么擅长躲弹幕呢"
            ]
        },
        "87_0": {
            "lines": [
                "唉，也行吧",
                "反正我上吊也死不了"
            ]
        },
        "89_0": {
            "lines": [
                "吊死的尸体很难看的"
            ]
        },
        "90_0": {
            "lines": [
                "你还是乖乖照着原本的歌词做吧"
            ]
        },
        "91_0": {
            "lines": [
                "原本的歌词？"
            ]
        },
        "92_0": {
            "lines": [
                "不是吧，你真不知道？"
            ]
        },
        "93_0": {
            "lines": [
                "She got married",
                "and then there were none..."
            ]
        },
        "95_0": {
            "lines": [
                "跟谁呀"
            ]
        },
        "96_0": {
            "lines": [
                "我给你介绍个神社的姑娘吧"
            ]
        }
    }
}