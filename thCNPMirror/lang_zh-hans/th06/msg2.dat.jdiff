{
    "0": {
        "60_0": {
            "lines": [
                "这湖原本有这么大吗？"
            ]
        },
        "61_0": {
            "lines": [
                "雾蒙蒙的根本看不清远处啊。"
            ]
        },
        "62_0": {
            "lines": [
                "难不成我是路痴？"
            ]
        },
        "92_h1_0": {
            "lines": [
                "湖上的冰精",
                "琪露诺"
            ]
        },
        "92_0": {
            "lines": [
                "迷失方向，是妖精在作怪哦"
            ]
        },
        "93_0": {
            "lines": [
                "是吗？那，你来带个路？",
                "这附近应该有座岛吧？"
            ]
        },
        "94_0": {
            "lines": [
                "你倒是惊讶一点好不好？",
                "一个强敌正拦在你面前呢"
            ]
        },
        "95_0": {
            "lines": [
                "枪靶？",
                "这可真是令人吃惊"
            ]
        },
        "96_0": {
            "lines": [
                "竟敢笑话咱～"
            ]
        },
        "97_0": {
            "lines": [
                "像你这样的人，就和英吉利牛肉一起",
                "冰冻冷藏起来吧！！"
            ]
        }
    },
    "1": {
        "60_0": {
            "lines": [
                "哎呀，越来越冷了"
            ]
        },
        "60_1": {
            "lines": [
                "这样会得空调病的"
            ]
        }
    },
    "10": {
        "60_0": {
            "lines": [
                "我记得小岛是在",
                "这边来着吧……"
            ]
        },
        "61_0": {
            "lines": [
                "难不成还长腿跑了？"
            ]
        },
        "62_0": {
            "lines": [
                "话说回来……"
            ]
        },
        "63_0": {
            "lines": [
                "差不多都夏天了吧",
                "为啥还这么冷啊？"
            ]
        },
        "93_h1_0": {
            "lines": [
                "湖上的冰精",
                "琪露诺"
            ]
        },
        "93_0": {
            "lines": [
                "咱要让你再也上不了岸！"
            ]
        },
        "94_0": {
            "lines": [
                "这么冷是你在捣鬼吧。"
            ]
        },
        "95_0": {
            "lines": [
                "总比大热天要好吧？"
            ]
        },
        "96_0": {
            "lines": [
                "好一个冷场高手"
            ]
        },
        "97_0": {
            "lines": [
                "这说法怎么感觉不太对……"
            ]
        },
        "98_0": {
            "lines": [
                "吃不消了吧？"
            ]
        }
    },
    "11": {
        "60_0": {
            "lines": [
                "唉，只穿短袖容易着凉啊"
            ]
        },
        "61_0": {
            "lines": [
                "走喽",
                "赶紧找户人家讨茶喝"
            ]
        }
    }
}