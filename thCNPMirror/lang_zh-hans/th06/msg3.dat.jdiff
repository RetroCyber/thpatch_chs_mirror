{
    "2": {
        "60_0": {
            "lines": [
                "可恶，得摆背水阵了！"
            ]
        },
        "180_0": {
            "lines": [
                "你一个人也算「阵」吗？"
            ]
        }
    },
    "0": {
        "60_0": {
            "lines": [
                "你别跟着我呀～"
            ]
        },
        "61_0": {
            "lines": [
                "多谢带路～"
            ]
        },
        "62_h1_0": {
            "lines": [
                "华人小姑娘",
                "红美铃"
            ]
        },
        "62_0": {
            "lines": [
                "唉呀，这边就是一片空地",
                "你跟着我又能怎样呢？"
            ]
        },
        "63_0": {
            "lines": [
                "哪有人会朝着空地逃跑的？"
            ]
        },
        "64_0": {
            "lines": [
                "嗯——真要逃跑的时候",
                "可管不了这么多吧"
            ]
        },
        "66_0": {
            "lines": [
                "顺便问一句，你是什么人？"
            ]
        },
        "67_0": {
            "lines": [
                "哎——我就是个普通人"
            ]
        },
        "68_0": {
            "lines": [
                "可刚才你出手攻击我了吧？"
            ]
        },
        "69_0": {
            "lines": [
                "那是普通的攻击",
                "再说了，是你先动手的好吧"
            ]
        },
        "70_0": {
            "lines": [
                "你这人，可不普通啊"
            ]
        },
        "71_0": {
            "lines": [
                "我是个当巫女的普通人哦"
            ]
        },
        "72_0": {
            "lines": [
                "那可太好了",
                "我记得……"
            ]
        },
        "74_0": {
            "lines": [
                "传说巫女是一种",
                "可以吃的人类……"
            ]
        },
        "76_0": {
            "lines": [
                "别传这种说！"
            ]
        }
    },
    "1": {
        "61_0": {
            "lines": [
                "好，那就请你带路吧"
            ]
        },
        "63_0": {
            "lines": [
                "再往前啥都没了",
                "因为是体验版来着"
            ]
        },
        "64_0": {
            "lines": [
                "嘛，那就没辙了"
            ]
        },
        "62_0": {
            "lines": [
                "对不起，大小姐～"
            ]
        }
    },
    "12": {
        "60_0": {
            "lines": [
                "可恶，先跑再说！"
            ]
        },
        "180_0": {
            "lines": [
                "想跑就跑呗"
            ]
        }
    },
    "10": {
        "60_0": {
            "lines": [
                "啊，刚才真是谢谢了"
            ]
        },
        "61_0": {
            "lines": [
                "好久不见啊"
            ]
        },
        "63_h1_0": {
            "lines": [
                "华人小姑娘",
                "红美铃"
            ]
        },
        "62_0": {
            "lines": [
                "不对，我跟你什么时候",
                "混成熟人了～"
            ]
        },
        "64_0": {
            "lines": [
                "就刚才呀？"
            ]
        },
        "65_0": {
            "lines": [
                "呃——遇到怪人了"
            ]
        },
        "67_0": {
            "lines": [
                "好了，别挡路",
                "你是这里的守门人吧？"
            ]
        },
        "69_0": {
            "lines": [
                "正因为是守门人，所以才要挡路"
            ]
        },
        "70_0": {
            "lines": [
                "你果真是守门人？"
            ]
        },
        "71_0": {
            "lines": [
                "我只是个负责守门的普通人"
            ]
        },
        "72_0": {
            "lines": [
                "说到底就是普通人呗",
                "那我要将你就地处决"
            ]
        },
        "74_0": {
            "lines": [
                "你这家伙，受的是哪门子教育啊"
            ]
        }
    },
    "11": {
        "61_0": {
            "lines": [
                "跟普通人战斗",
                "到底不合我的性子啊"
            ]
        },
        "62_0": {
            "lines": [
                "胡扯～"
            ]
        }
    }
}