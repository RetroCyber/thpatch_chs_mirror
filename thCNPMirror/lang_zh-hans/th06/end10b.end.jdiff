{
    "21": {
        "lines": [
            "　　BAD　ENDING　No.2",
            "　　争取不续关打通Normal及更高难度吧！"
        ]
    },
    "18": {
        "lines": [
            "　　今年的夏天格外昏暗，放晴的日子恐怕还很遥远。"
        ]
    },
    "15": {
        "lines": [
            "魔理沙　「嘿，我就这么一说试试」"
        ]
    },
    "12": {
        "lines": [
            "魔理沙　「可恶——好不甘心呀",
            "　　　　　我怎么会败给那种家伙呢」"
        ]
    },
    "8": {
        "lines": [
            "　　森林之中，一片昏暗。",
            "　　这座森林始终没有取回原本的明媚。"
        ]
    }
}