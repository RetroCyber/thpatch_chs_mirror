{
    "8": {
        "lines": [
            "　　幻想乡迎来了夏天。",
            "　　歇息了好一阵子的太阳终于露了面，",
            "　　将所有的红雾一扫而空。",
            "　　窗户稀少的红魔馆也坦坦荡荡地现身在光天化日之下……"
        ]
    },
    "100": {
        "lines": [
            "　　ENDING　No.6"
        ]
    },
    "96": {
        "lines": [
            "　　幻想之馆并未发生任何变化。",
            "　　唯有夏季的熏风不断吹拂，仿佛在诉说对变化的渴望。"
        ]
    },
    "15": {
        "lines": [
            "　魔理沙「···」"
        ]
    },
    "17": {
        "lines": [
            "　魔理沙「····」"
        ]
    },
    "19": {
        "lines": [
            "　魔理沙「……唔——」"
        ]
    },
    "21": {
        "lines": [
            "　魔理沙「……这本书好像挺有意思的。",
            "　　　　　可惜这什么世界语，我看不太懂。」"
        ]
    },
    "25": {
        "lines": [
            "　？？　「你又来了」"
        ]
    },
    "28": {
        "lines": [
            "　魔理沙「我没来」"
        ]
    },
    "32": {
        "lines": [
            "　咲夜　「不要擅自闯进来偷看别人的书，",
            "　　　　　这叫私闯民宅」"
        ]
    },
    "36": {
        "lines": [
            "　魔理沙「我天天过来串门，哪怕你这的茶水再难喝，",
            "　　　　　也差不多该端一杯上来了吧？」"
        ]
    },
    "40": {
        "lines": [
            "　咲夜　「我们这只有好喝的茶。」"
        ]
    },
    "43": {
        "lines": [
            "　魔理沙「再说了，书本来就是拿来看的嘛」"
        ]
    },
    "46": {
        "lines": [
            "　咲夜　「你看得懂这本书？」"
        ]
    },
    "49": {
        "lines": [
            "　？？　「喂——咲夜——你在哪——」"
        ]
    },
    "52": {
        "lines": [
            "　咲夜　「啊，大小姐来了。",
            "　　　　　你先找地方躲一下」"
        ]
    },
    "56": {
        "lines": [
            "　咲夜　「大小姐，我在这里——」"
        ]
    },
    "60": {
        "lines": [
            "蕾米莉亚「可算找到了，你有在认真打扫卫生吗？」"
        ]
    },
    "63": {
        "lines": [
            "　咲夜　「嗯，那当然啦」"
        ]
    },
    "66": {
        "lines": [
            "蕾米莉亚「我稍微出个门，你要好好看家呀」"
        ]
    },
    "69": {
        "lines": [
            "　咲夜　「外面出太阳了，",
            "　　　　　您别忘记带上阳伞。」"
        ]
    },
    "73": {
        "lines": [
            "蕾米莉亚「放心，性命攸关的事我怎么会忘呢」"
        ]
    },
    "76": {
        "lines": [
            "蕾米莉亚「话说，这书房里有股老鼠味儿呀」"
        ]
    },
    "79": {
        "lines": [
            "　咲夜　「您不必担心，这股味道只是",
            "　　　　　闻着像老鼠的腐臭，",
            "　　　　　但老鼠并没有腐烂。」"
        ]
    },
    "84": {
        "lines": [
            "蕾米莉亚「行吧，记得打扫干净呀，我先走了」"
        ]
    },
    "87": {
        "lines": [
            "　咲夜　「祝您一路顺风」"
        ]
    },
    "90": {
        "lines": [
            "　咲夜　「没事的，老鼠还活蹦乱跳着呢」"
        ]
    },
    "93": {
        "lines": [
            "　魔理沙「这是在说我吗」"
        ]
    }
}