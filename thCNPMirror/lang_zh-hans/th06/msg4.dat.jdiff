{
    "0": {
        "60_0": {
            "lines": [
                "这房子里一扇窗户都没有吗？"
            ]
        },
        "61_0": {
            "lines": [
                "而且从外面看起来",
                "没觉得有这么宽敞啊？"
            ]
        },
        "92_0": {
            "lines": [
                "那边的红白！"
            ]
        },
        "93_0": {
            "lines": [
                "别在我的书房里胡闹"
            ]
        },
        "94_0": {
            "lines": [
                "书房？（红白？）"
            ]
        },
        "95_h1_0": {
            "lines": [
                "知识与避世的少女",
                "帕秋莉·诺蕾姬"
            ]
        },
        "95_0": {
            "lines": [
                "这些书的价值可抵得上",
                "你那神社五年的香火钱呢"
            ]
        },
        "96_0": {
            "lines": [
                "但我家神社全年无休也没人参拜呀"
            ]
        },
        "97_0": {
            "lines": [
                "唉，这些书也就值这么点钱了"
            ]
        },
        "98_0": {
            "lines": [
                "话说，你真能在",
                "这么暗的屋子里看书？"
            ]
        },
        "100_0": {
            "lines": [
                "和你不一样",
                "我可不是雀盲眼"
            ]
        },
        "102_0": {
            "lines": [
                "都说啦～",
                "我不是雀盲眼"
            ]
        },
        "104_0": {
            "lines": [
                "啊，忘了说正事",
                "你是这地方的主人吗？"
            ]
        },
        "106_0": {
            "lines": [
                "你找大小姐有什么事？"
            ]
        },
        "107_0": {
            "lines": [
                "你们弄出了太多雾气，很烦人"
            ]
        },
        "108_0": {
            "lines": [
                "那我可绝不能让你靠近大小姐"
            ]
        },
        "110_0": {
            "lines": [
                "休想碍事"
            ]
        },
        "111_0": {
            "lines": [
                "……对了，你谁啊？"
            ]
        }
    },
    "1": {
        "61_0": {
            "lines": [
                "说起来，这宅子从外头看起来",
                "也没这么宽敞吧？"
            ]
        },
        "62_0": {
            "lines": [
                "这是因为家里有个人",
                "喜欢倒腾空间"
            ]
        }
    },
    "10": {
        "60_0": {
            "lines": [
                "哇，好多书呀"
            ]
        },
        "61_0": {
            "lines": [
                "待会再顺几本走吧"
            ]
        },
        "91_0": {
            "lines": [
                "不准拿——"
            ]
        },
        "92_0": {
            "lines": [
                "就要拿"
            ]
        },
        "94_h1_0": {
            "lines": [
                "知识与避世的少女",
                "帕秋莉·诺蕾姬"
            ]
        },
        "93_0": {
            "lines": [
                "让我看看——用被动方式",
                "处理眼前的黑东西需要……"
            ]
        },
        "95_0": {
            "lines": [
                "（书里还写这个？）"
            ]
        },
        "96_0": {
            "lines": [
                "嗯——最近视力不太好呀"
            ]
        },
        "97_0": {
            "lines": [
                "不是因为屋子里太暗了吗？"
            ]
        },
        "98_0": {
            "lines": [
                "是不是缺铁呢"
            ]
        },
        "99_0": {
            "lines": [
                "要缺也是缺维生素A吧"
            ]
        },
        "100_0": {
            "lines": [
                "你呢？"
            ]
        },
        "101_0": {
            "lines": [
                "我啥也不缺，样样俱全"
            ]
        },
        "102_0": {
            "lines": [
                "那就拿你做菜补补身子"
            ]
        },
        "103_0": {
            "lines": [
                "我可是相当美味哦"
            ]
        },
        "104_0": {
            "lines": [
                "让我看看——",
                "轻松去除食材涩味的方法是……"
            ]
        }
    },
    "11": {
        "61_0": {
            "lines": [
                "你似乎挺擅长魔法呀",
                "应该还藏着什么招数吧？"
            ]
        },
        "62_0": {
            "lines": [
                "呜呜呜，都是贫血害得我",
                "没能完成符卡的咏唱"
            ]
        }
    }
}