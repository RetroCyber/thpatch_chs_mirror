{
    "8": {
        "lines": [
            "　　幻想乡迎来了夏天。",
            "　　歇息了好一阵子的太阳终于露了面，",
            "　　将所有的红雾一扫而空。",
            "　　窗户稀少的红魔馆也坦坦荡荡地现身在光天化日之下……"
        ]
    },
    "15": {
        "lines": [
            "　咲夜　「唉——事又多、天又热，真受够了，",
            "　　　　　所以说还是雾天好啊」"
        ]
    },
    "18": {
        "lines": [
            "　咲夜　「啊，快到吃茶点的时间了",
            "　　　　　不过也不急，反正可以停止时间慢慢准备」"
        ]
    },
    "92": {
        "lines": [
            "　　今日，夏色的幻想依然一派祥和，令时间停止不前。",
            "　　或许，时间再也不会有恢复前进的那一天了。"
        ]
    },
    "96": {
        "lines": [
            "　　ENDING　No.5"
        ]
    },
    "22": {
        "lines": [
            "　？？　「茶点还没好吗？」"
        ]
    },
    "25": {
        "lines": [
            "　咲夜　「好的，大小姐，我这就过来」"
        ]
    },
    "28": {
        "lines": [
            "　咲夜　「让您久等了」"
        ]
    },
    "31": {
        "lines": [
            "　魔理沙「辛苦啦」"
        ]
    },
    "34": {
        "lines": [
            "　咲夜　「今天的红茶是产自康提的稀世珍品」"
        ]
    },
    "37": {
        "lines": [
            "　魔理沙「颜色太红了，看着就倒胃口」"
        ]
    },
    "40": {
        "lines": [
            "　咲夜　「顺便一提，蛋糕里面也加入了珍品」"
        ]
    },
    "43": {
        "lines": [
            "　魔理沙「你到底加了什么(^^;」"
        ]
    },
    "46": {
        "lines": [
            "　咲夜　「就是竹花什么的」"
        ]
    },
    "49": {
        "lines": [
            "　咲夜　「虽说竹子六十年才开一次花，但我能够操控时间，",
            "　　　　　所以能让它立刻绽放」"
        ]
    },
    "53": {
        "lines": [
            "　魔理沙「不过，这玩意儿好吃吗？」"
        ]
    },
    "56": {
        "lines": [
            "　咲夜　「这可是珍品」"
        ]
    },
    "60": {
        "lines": [
            "蕾米莉亚「不是，你怎么堂而皇之地待在我家呢",
            "　　　　　等等，你怎么还擅自吃起了别人的茶点呀——」"
        ]
    },
    "64": {
        "lines": [
            "　魔理沙「人的茶点人来吃嘛」"
        ]
    },
    "67": {
        "lines": [
            "　咲夜　「啊，大小姐，这里还有呢」"
        ]
    },
    "70": {
        "lines": [
            "蕾米莉亚「今天的茶点是什么？」"
        ]
    },
    "73": {
        "lines": [
            "　咲夜　「是珍品」"
        ]
    },
    "76": {
        "lines": [
            "蕾米莉亚「好耶——我最喜欢吃啦」"
        ]
    },
    "79": {
        "lines": [
            "　魔理沙「你可别喜欢上什么怪东西呀（汗）」"
        ]
    },
    "82": {
        "lines": [
            "　魔理沙「……不是我说，今年夏天也太热了吧。」"
        ]
    },
    "85": {
        "lines": [
            "蕾米莉亚「你瞧瞧，还是雾天好吧",
            "　　　　　都怪你当时非要让我收手」"
        ]
    },
    "89": {
        "lines": [
            "　魔理沙「……有时候就是会这么想嘛」"
        ]
    }
}