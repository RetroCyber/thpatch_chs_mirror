{
    "2": {
        "60_0": {
            "lines": [
                "啊——扫除还没搞完！"
            ]
        },
        "150_0": {
            "lines": [
                "这样会惹大小姐生气的！！"
            ]
        }
    },
    "0": {
        "60_0": {
            "lines": [
                "你怎么又来妨碍我搞卫生了～"
            ]
        },
        "61_0": {
            "lines": [
                "你——",
                "看起来不像这里的主人呢"
            ]
        },
        "64_h1_0": {
            "lines": [
                "红魔馆的女仆",
                "十六夜咲夜"
            ]
        },
        "63_0": {
            "lines": [
                "怎么？",
                "你是大小姐的客人？"
            ]
        },
        "65_0": {
            "lines": [
                "（如果说我是来打倒她的",
                "这人也不会放我过去吧）"
            ]
        },
        "67_0": {
            "lines": [
                "我不会让你过去的哦"
            ]
        },
        "68_0": {
            "lines": [
                "大小姐平日里很少见人"
            ]
        },
        "70_0": {
            "lines": [
                "她被软禁了吗？"
            ]
        },
        "71_0": {
            "lines": [
                "大小姐只是喜欢待在阴暗处罢了"
            ]
        },
        "72_0": {
            "lines": [
                "那问问不阴暗的你也成"
            ]
        },
        "73_0": {
            "lines": [
                "制造雾气笼罩这一带的",
                "就是你们吧？"
            ]
        },
        "75_0": {
            "lines": [
                "这雾很烦人哪",
                "你们到底有什么目的？"
            ]
        },
        "77_0": {
            "lines": [
                "我们这么做是因为阳光太碍事了",
                "我家大小姐喜欢幽暗"
            ]
        },
        "79_0": {
            "lines": [
                "但我不喜欢",
                "能请你们就此打住吗？"
            ]
        },
        "81_0": {
            "lines": [
                "这你得跟大小姐说去"
            ]
        },
        "82_0": {
            "lines": [
                "那你把她叫来"
            ]
        },
        "83_0": {
            "lines": [
                "哼，我怎么可能让主人",
                "以身犯险呢？"
            ]
        },
        "85_0": {
            "lines": [
                "我要是在这儿大闹一场",
                "她应该就会露面了吧？"
            ]
        },
        "87_0": {
            "lines": [
                "现在就已经够闹腾的了"
            ]
        },
        "88_0": {
            "lines": [
                "不过，你是见不到大小姐的"
            ]
        },
        "90_0": {
            "lines": [
                "为了争取时间",
                "我甚至可以停止时间"
            ]
        }
    },
    "3": {
        "61_0": {
            "lines": [
                "怎么样，服不服！"
            ]
        },
        "62_0": {
            "lines": [
                "你还差得远呢",
                "就这点本事有什么好得意的"
            ]
        },
        "64_0": {
            "lines": [
                "回到两个小时前重新来过吧"
            ]
        }
    },
    "1": {
        "61_0": {
            "lines": [
                "如何，愿意带我去见她了吗"
            ]
        },
        "62_0": {
            "lines": [
                "好强……",
                "但以大小姐的实力，或许……"
            ]
        }
    },
    "12": {
        "60_0": {
            "lines": [
                "啊——扫除还没搞完！"
            ]
        },
        "150_0": {
            "lines": [
                "这样会惹大小姐生气的！！"
            ]
        }
    },
    "10": {
        "60_0": {
            "lines": [
                "你怎么又来妨碍我搞卫生了～"
            ]
        },
        "61_0": {
            "lines": [
                "哎呦喂，居然是女仆"
            ]
        },
        "62_0": {
            "lines": [
                "要是把她抓起来",
                "就会触犯华盛顿公约呀"
            ]
        },
        "65_h1_0": {
            "lines": [
                "红魔馆的女仆",
                "十六夜咲夜"
            ]
        },
        "64_0": {
            "lines": [
                "对啊，你们魔法使应该属于",
                "生类怜悯令的保护对象吧"
            ]
        },
        "66_0": {
            "lines": [
                "怜悯怜悯我吧"
            ]
        },
        "67_0": {
            "lines": [
                "怎么？"
            ]
        },
        "68_0": {
            "lines": [
                "你也是我家的雇工吗？"
            ]
        },
        "70_0": {
            "lines": [
                "嗯，这倒也行"
            ]
        },
        "70_1": {
            "lines": [
                "不过，你连打扫卫生都不会吧"
            ]
        },
        "72_0": {
            "lines": [
                "不会"
            ]
        },
        "73_0": {
            "lines": [
                "那你是负责什么的？",
                "恋爱吗？"
            ]
        },
        "75_0": {
            "lines": [
                "其实我是维修委员"
            ]
        },
        "76_0": {
            "lines": [
                "你说什么呀",
                "这里又不是小学"
            ]
        },
        "78_0": {
            "lines": [
                "敢情初中还有恋爱委员？"
            ]
        },
        "79_0": {
            "lines": [
                "好吧，那我现在就给你安排工作"
            ]
        },
        "81_0": {
            "lines": [
                "刚才忘记说了，我叫咲夜",
                "是这里的女仆长。"
            ]
        },
        "83_0": {
            "lines": [
                "也就是说，只要打败你",
                "就能当上女仆长呗"
            ]
        },
        "85_0": {
            "lines": [
                "说这话的人排起队来比钍衰变链还长",
                "但最后全都成了我的手下败将"
            ]
        },
        "87_0": {
            "lines": [
                "哦，这种事还挺常见嘛"
            ]
        },
        "89_0": {
            "lines": [
                "你的时间同样属于我……",
                "像你这种古典魔女，根本毫无胜算"
            ]
        }
    },
    "13": {
        "61_0": {
            "lines": [
                "啊——好累"
            ]
        },
        "62_0": {
            "lines": [
                "你也该回去了吧？",
                "我还有事要忙呢"
            ]
        },
        "64_0": {
            "lines": [
                "行吧"
            ]
        },
        "65_0": {
            "lines": [
                "是吗？",
                "那再见了"
            ]
        }
    },
    "11": {
        "61_0": {
            "lines": [
                "就算不是女仆",
                "也能成为女仆长吗？"
            ]
        },
        "63_0": {
            "lines": [
                "怎么可能"
            ]
        }
    }
}