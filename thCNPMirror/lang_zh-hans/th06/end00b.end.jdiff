{
    "21": {
        "lines": [
            "　　BAD　ENDING　No.1",
            "　　争取不续关打通Normal及更高难度吧！"
        ]
    },
    "18": {
        "lines": [
            "　　打败那家伙之后，红雾真的就会消散吗？",
            "\t　　由于修行不到家，红色的夏天还远远没有结束。"
        ]
    },
    "8": {
        "lines": [
            "　　夏天的神社门可罗雀。",
            "　　这座神社至今仍未取回夏日的阳光。"
        ]
    },
    "12": {
        "lines": [
            "　灵梦　「这下难办了，",
            "　　　　　不打败那家伙，雾就散不了吗？」"
        ]
    },
    "15": {
        "lines": [
            "　灵梦　「话说回来，为啥天气这么凉快呀」"
        ]
    }
}